    {
      "name": "GraphQL Budget Operations",
      "item": [
        {
          "name": "GraphQL - Create Budget",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { createBudget(userId: \\\"user123\\\", categoryId: 1, year: 2026, month: 6, amount: 5000.00, isActive: true, recurrence: \\\"monthly\\\") { id userId categoryId year month amount isActive recurrence createdAt updatedAt } }\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/graphql",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "graphql"
              ]
            },
            "description": "Create a budget via GraphQL with query parameters"
          },
          "response": []
        },
