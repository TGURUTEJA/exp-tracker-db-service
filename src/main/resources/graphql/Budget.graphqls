scalar DateTime

type Budget {
    id: ID
    userId: String
    categoryId: Int
    year: Int
    month: Int
    amount: BigDecimal
    isActive: Boolean
    recurrence: String
    createdAt: DateTime
    updatedAt: DateTime
}

type BudgetResponse {
    message: String
    error: Boolean
    data: Budget
}

type BudgetListResponse {
    message: String
    error: Boolean
    data: [Budget]
}

type BudgetDeleteResponse {
    message: String
    error: Boolean!
    data: Boolean
}

input BudgetInput {
    userId: String
    categoryId: Int
    year: Int
    month: Int
    amount: BigDecimal
    isActive: Boolean
    recurrence: String
}

input BudgetDateRangeInput {
    userId: String!
    startYear: Int!
    startMonth: Int!
    endYear: Int!
    endMonth: Int!
}
