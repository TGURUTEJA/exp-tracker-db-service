type Query {

    getAllUsers: UserListResponse!
    getUserById(input: IDInput!): UserDetailsResponse!

    getCategoryById(id: ID!): Category
    getCategoriesByUserId(userId: String!): [Category!]!
    getAllCategories: [Category!]!

    getAllAccounts: AccountListResponse!
    getAccountById(id: ID!): AccountResponse!
    getAccountsByUserId(input: IDInput!): AccountListResponse!
    getTransactionsByUserId(
        userId: String!,
        startDate: String,
        endDate: String,
        accountId: Float,
        categoryId: Int,
        newestFirst: Boolean
    ): [Transaction!]!

    getBudgetById(id: ID!, userId: String!): Budget
    getBudgetsByUserId(userId: String!): [Budget!]!
    getBudgetsByUserIdAndDateRange(userId: String!, startYear: Int!, startMonth: Int!, endYear: Int!, endMonth: Int!): [Budget!]!
}


type Mutation {

    createUser(input: UserInput!): UserDetailsResponse!
    updateUser(id: String!, input: UserInput!): UserDetailsResponse!
    deleteUser(id: String!): UserDeleteResponse!

    createCategory(input: CategoryInput!): Category!
    createMultipleCategories(input: [CategoryInput!]!): [Category!]!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!, userId: String!): Boolean!

    createAccount(body: AccountInput!): AccountResponse!
    updateAccount(id: ID!, body: AccountInput!): AccountResponse!
    deleteAccount(id: ID!): AccountResponse!

    createTransaction(userId: String!, input: TransactionPojo!): TransactionResponse!
    updateTransaction(id: Int!, userId: String!, input: TransactionPojo!): TransactionResponse!
    deleteTransaction(id: Int!, userId: String!): TransactionDeleteResponse!

    createBudget(userId: String!, categoryId: Int!, year: Int!, month: Int!, amount: BigDecimal!, isActive: Boolean, recurrence: String): Budget!
    updateBudget(id: ID!, userId: String!, categoryId: Int, year: Int, month: Int, amount: BigDecimal, isActive: Boolean, recurrence: String): Budget!
    deleteBudget(id: ID!, userId: String!): Boolean!
}
