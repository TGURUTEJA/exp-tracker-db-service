type Transaction {
    id: Int
    userId: String
    accountId: Float
    amount: BigDecimal
    debitCredit: String
    categoryId: Int
    description: String
    created: String
    accountBalance: BigDecimal
}

type TransactionListResponse{
    message: String
    error: Boolean
    data: [Transaction]
}
type TransactionResponse{
    message: String
    error: Boolean
    data: Transaction
}
type TransactionDeleteResponse{
    message: String
    error: Boolean!
    data: Boolean
}
input TransactionPojo {
    accountId: Float!
    debitCredit: String!
    categoryId: Int
    description: String
    amount: BigDecimal!
    created: String
}